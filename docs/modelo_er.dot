digraph G {
 graph [rankdir=LR, bgcolor="white", nodesep=.4, ranksep=.9, splines=polyline];
 node [shape=record, fontname="DejaVu Sans", fontsize=10, color="#2f647b", style="rounded,filled", fillcolor="#f3fafc"];
 edge [fontname="DejaVu Sans", fontsize=9, color="#678899", arrowsize=.7];
 users [label="users | PK id | FK patient_id | email, password, role"];
 patients [label="patients | PK id | full_name, email, phone"];
 specialties [label="specialties | PK id | name"];
 doctors [label="doctors | PK id | FK specialty_id | full_name, price, profile, active"];
 schedules [label="doctor_schedules | PK id | FK doctor_id | weekday, hours"];
 appointments [label="appointments | PK id | FK patient_id, doctor_id | starts_at, price_at_booking, status"];
 reviews [label="reviews | PK id | FK appointment_id | rating, comment?, wait_minutes?"];
 tags [label="review_tags | PK id | name"];
 reviewTags [label="review_tag_assignments | PK/FK review_id | PK/FK tag_id"];
 results [label="medical_results | PK id | FK patient_id | exam_name, result_type"];
 num [label="numeric_results | PK/FK result_id | measured_value, unit, range"];
 qual [label="qualitative_results | PK/FK result_id | finding"];
 imaging [label="imaging_results | PK/FK result_id | report_text, image_path"];
 patients -> users [label="1 : 0..1"];
 specialties -> doctors [label="1 : N"];
 doctors -> schedules [label="1 : N"];
 doctors -> appointments [label="1 : N"];
 patients -> appointments [label="1 : N"];
 appointments -> reviews [label="1 : 0..1"];
 reviews -> reviewTags [label="1 : N"];
 tags -> reviewTags [label="1 : N"];
 patients -> results [label="1 : N"];
 results -> num [label="1 : 0..1"];
 results -> qual [label="1 : 0..1"];
 results -> imaging [label="1 : 0..1"];
}
